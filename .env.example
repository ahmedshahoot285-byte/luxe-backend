# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Supabase → Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Shared secret for admin API endpoints — generate with: openssl rand -hex 32
ADMIN_SECRET=change-me-to-a-long-random-string


# ── Optional ──────────────────────────────────────────────────────────────────

# Redis URL for BullMQ (without it, imports run inline via setImmediate)
REDIS_URL=redis://default:[password]@[host]:6379

# Port to listen on (Railway sets this automatically)
PORT=4000

# Frontend origin allowed by CORS
FRONTEND_URL=https://luxe.ly

# Where to write backup files (defaults to ./backups relative to process.cwd())
# Mount a Railway volume at this path for persistence across deploys
BACKUP_DIR=/data/backups

# How many days to keep backup files before auto-deletion (default: 30)
BACKUP_RETAIN_DAYS=30

# Node environment
NODE_ENV=production
